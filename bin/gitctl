#!/usr/bin/env bash
# gitctl — gestor de Git worktrees: crear, saltar, integrar y limpiar.
set -euo pipefail

GITCTL_VERSION="0.2.0"
_self="$(readlink -f "${BASH_SOURCE[0]}")"
GITCTL_HOME="$(cd "$(dirname "$_self")/.." && pwd)"
GITCTL_LIB="$GITCTL_HOME/lib"

for _f in "$GITCTL_LIB"/core/*.sh "$GITCTL_LIB"/cmd/*.sh; do
	# shellcheck source=/dev/null
	source "$_f"
done
unset _f _self

usage() {
	cat <<'H'
gitctl — gestor de Git worktrees

Uso: gitctl [opciones] <comando> [argumentos]
     gitctl                     (sin argumentos: menú interactivo; sin terminal, gitctl ls)

  i                          Menú interactivo con todas las acciones
  new <rama> [--base RAMA]   Crea rama + worktree, lo prepara y te deja dentro
  cd [<rama>]                Salta a un worktree (sin argumento, al principal)
  ls                         Lista los worktrees y su estado
  diff [<rama>] [--stat|--log]  Compara un worktree con su base (lo que aportaría el merge)
  merge [<rama>]             Integra el worktree en su base (merge commit) y lo limpia
  merge --continue           Termina un merge que dejaste con conflictos
  pr [<rama>] [--title T]    Sube la rama y abre una pull request hacia su base (gh)
  rm <rama> [--force]        Elimina un worktree y su rama
  clean [--dry-run]          Elimina los worktrees ya integrados
  shell-init bash|zsh        Función de shell para el cd automático
  init                       Crea un .gitctl.conf de ejemplo
  doctor                     Comprueba git, repositorio, config y shell

Opciones globales
  -q, --quiet     Menos mensajes          -v, --verbose   Más mensajes
  -y, --yes       Responde «sí» a las confirmaciones
  -h, --help      Ayuda                   --version       Versión

Ejecuta «gitctl <comando> --help» para la ayuda de cada comando.
H
}

main() {
	while (($#)); do
		case "$1" in
		-q | --quiet) export GITCTL_QUIET=1 ;;
		-v | --verbose) export GITCTL_VERBOSE=1 ;;
		-y | --yes) export GITCTL_YES=1 ;;
		-h | --help)
			usage
			return 0
			;;
		--version)
			echo "gitctl $GITCTL_VERSION"
			return 0
			;;
		-*) die "opción desconocida: $1 (ver gitctl --help)" ;;
		*) break ;;
		esac
		shift
	done

	if (($# == 0)); then
		if is_interactive; then set -- i; else set -- ls; fi
	fi
	local cmd="$1"
	shift
	case "$cmd" in
	i | interactive) cmd_interactive "$@" ;;
	new) cmd_new "$@" ;;
	cd) cmd_cd "$@" ;;
	ls | list) cmd_ls "$@" ;;
	diff) cmd_diff "$@" ;;
	merge) cmd_merge "$@" ;;
	pr) cmd_pr "$@" ;;
	rm | remove) cmd_rm "$@" ;;
	clean) cmd_clean "$@" ;;
	shell-init) cmd_shell_init "$@" ;;
	init) cmd_init "$@" ;;
	doctor) cmd_doctor "$@" ;;
	help) usage ;;
	version) echo "gitctl $GITCTL_VERSION" ;;
	*) die "comando desconocido: $cmd (ver gitctl --help)" ;;
	esac
}

main "$@"
